VTCA_PORT=8000
# 使用 python run_nsysu.py 同時啟動日誌與 Dashboard。
VTCA_DASHBOARD_PORT=8501
# 舊 Flask 網頁的入口設定；單一 Streamlit 入口使用 PUBLIC_APP_URL。
VTCA_DIARY_URL=http://127.0.0.1:8000/
VTCA_DASHBOARD_URL=http://127.0.0.1:8501/

# LINE backend only; ordinary pages expose official ID and join link only.
